---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { tagToSlug } from '@/lib/tags';

const articles = await getCollection('articles');
const tagCounts = new Map<string, { label: string; count: number }>();
for (const article of articles) {
  for (const tag of article.data.tags) {
    const slug = tagToSlug(tag);
    const existing = tagCounts.get(slug);
    tagCounts.set(slug, { label: tag, count: (existing?.count ?? 0) + 1 });
  }
}
const tags = Array.from(tagCounts.entries())
  .map(([slug, { label, count }]) => ({ slug, label, count }))
  .sort((a, b) => a.label.localeCompare(b.label));
---

<BaseLayout title="Tags" description="Browse articles by tag.">
  <section class="page">
    <h1 class="font-display page__title">Tags</h1>
    {
      tags.length > 0 ? (
        <ul class="tag-list">
          {tags.map((tag) => (
            <li>
              <a href={`/tags/${tag.slug}`}>
                #{tag.label} <span>({tag.count})</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="page__lede">No tags yet.</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .page {
    max-width: 48rem;
    margin-inline: auto;
    padding: 3rem 1.25rem 4rem;
  }
  .page__title {
    color: var(--color-paper-50);
    font-size: 2.25rem;
    margin: 0 0 1.5rem;
  }
  .page__lede {
    color: var(--color-paper-200);
  }
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 0;
    list-style: none;
  }
  .tag-list a {
    font-size: 0.85rem;
    color: var(--color-paper-100);
    background: var(--color-ink-900);
    border: 1px solid var(--color-ink-700);
    border-radius: 999px;
    padding: 0.4em 1em;
    text-decoration: none;
  }
  .tag-list a:hover {
    color: var(--color-brass-400);
    border-color: var(--color-brass-500);
  }
  .tag-list span {
    color: var(--color-ink-500);
  }
</style>
