---
import type { CollectionEntry } from 'astro:content';
import { CATEGORY_META } from '@/lib/categories';

interface Props {
  articles: CollectionEntry<'articles'>[];
  exploreHref: string;
}
const { articles, exploreHref } = Astro.props;
---

<section class="scroll-reveal">
  <div class="scroll-reveal__stage">
    <div class="scroll-reveal__track">
      {
        articles.map((article) => {
          const primaryCategory = article.data.categories[0];
          const categoryLabel = CATEGORY_META[primaryCategory]?.label ?? primaryCategory;
          return (
            <a href={`/articles/${article.id}`} class="scroll-reveal__frame">
              <div class="scroll-reveal__media">
                {article.data.heroImage ? (
                  <img
                    src={article.data.heroImage}
                    alt={article.data.heroImageAlt ?? ''}
                    loading="lazy"
                  />
                ) : (
                  <div class="scroll-reveal__placeholder" aria-hidden="true" />
                )}
                <div class="scroll-reveal__scrim" aria-hidden="true" />
              </div>
              <div class="scroll-reveal__caption">
                <p class="scroll-reveal__title font-display">{article.data.title}</p>
                <p class="scroll-reveal__meta">
                  {categoryLabel} · {article.data.period}
                </p>
              </div>
            </a>
          );
        })
      }
      <a href={exploreHref} class="scroll-reveal__frame scroll-reveal__frame--cta">
        <span class="scroll-reveal__cta-text font-display">Explore all stories</span>
        <span class="scroll-reveal__cta-arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</section>

<style>
  .scroll-reveal {
    position: relative;
  }

  /* Base (always-on) fallback: a plain, fully usable full-bleed horizontal
     swipe gallery. This is what touch devices, reduced-motion users, and
     no-JS visitors get — JS below only upgrades it into a pinned effect. */
  .scroll-reveal__stage {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }
  .scroll-reveal__track {
    display: flex;
  }
  .scroll-reveal__frame {
    position: relative;
    flex: 0 0 100%;
    height: 100svh;
    scroll-snap-align: start;
    text-decoration: none;
    display: block;
    overflow: hidden;
  }

  .scroll-reveal__media,
  .scroll-reveal__placeholder {
    position: absolute;
    inset: 0;
  }
  .scroll-reveal__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .scroll-reveal__placeholder {
    background: linear-gradient(155deg, var(--color-ink-700), var(--color-ink-950));
  }
  .scroll-reveal__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(22, 19, 15, 0.9) 0%,
      rgba(22, 19, 15, 0.35) 45%,
      rgba(22, 19, 15, 0.15) 100%
    );
  }

  .scroll-reveal__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 2rem 1.5rem;
  }
  @media (min-width: 768px) {
    .scroll-reveal__caption {
      padding: 3rem 4rem;
    }
  }
  .scroll-reveal__title {
    color: var(--color-paper-50);
    font-size: 1.75rem;
    line-height: 1.15;
    margin: 0 0 0.4rem;
    max-width: 34rem;
  }
  @media (min-width: 768px) {
    .scroll-reveal__title {
      font-size: 2.75rem;
    }
  }
  .scroll-reveal__meta {
    color: var(--color-brass-400);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0;
  }

  .scroll-reveal__frame--cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background: var(--color-ink-900);
  }
  .scroll-reveal__cta-text {
    color: var(--color-paper-50);
    font-size: 2rem;
  }
  @media (min-width: 768px) {
    .scroll-reveal__cta-text {
      font-size: 3rem;
    }
  }
  .scroll-reveal__cta-arrow {
    color: var(--color-brass-400);
    font-size: 2rem;
    transition: transform 250ms ease;
  }
  .scroll-reveal__frame--cta:hover .scroll-reveal__cta-arrow {
    transform: translateX(0.4em);
  }

  /* Enhanced (JS-driven) pinned mode: vertical scroll drives horizontal
     movement, height set dynamically in script below to match content. */
  .scroll-reveal--pinned .scroll-reveal__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }
  .scroll-reveal--pinned .scroll-reveal__track {
    height: 100%;
    will-change: transform;
  }
  .scroll-reveal--pinned .scroll-reveal__frame {
    scroll-snap-align: none;
  }
</style>

<script>
  function initScrollReveal(section: HTMLElement) {
    const stageEl = section.querySelector<HTMLElement>('.scroll-reveal__stage');
    const trackEl = section.querySelector<HTMLElement>('.scroll-reveal__track');
    if (!stageEl || !trackEl) return;
    // Re-bind as non-nullable: TS control-flow narrowing above doesn't carry
    // into the nested closures below, since they could in theory be called
    // independently of this guard.
    const stage: HTMLElement = stageEl;
    const track: HTMLElement = trackEl;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const coarsePointer = window.matchMedia('(pointer: coarse)').matches;
    if (reduceMotion || coarsePointer) return; // keep the plain swipeable fallback

    section.classList.add('scroll-reveal--pinned');

    function layout() {
      const maxTranslate = Math.max(0, track.scrollWidth - stage.clientWidth);
      section.style.height = `calc(100svh + ${maxTranslate}px)`;
    }

    function update() {
      const maxTranslate = Math.max(0, track.scrollWidth - stage.clientWidth);
      const scrollable = section.offsetHeight - window.innerHeight;
      const rect = section.getBoundingClientRect();
      const progress = scrollable > 0 ? Math.min(1, Math.max(0, -rect.top / scrollable)) : 0;
      track.style.transform = `translate3d(${-progress * maxTranslate}px, 0, 0)`;
    }

    let ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        update();
        ticking = false;
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => {
      layout();
      update();
    });
    layout();
    update();
  }

  document
    .querySelectorAll<HTMLElement>('.scroll-reveal')
    .forEach(initScrollReveal);
</script>
