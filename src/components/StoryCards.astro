---
import type { CollectionEntry } from 'astro:content';
import { CATEGORY_META } from '@/lib/categories';

interface Props {
  articles: CollectionEntry<'articles'>[];
}
const { articles } = Astro.props;
---

<div class="story-cards not-prose">
  <p class="story-cards__hint no-scrollbar">
    <span aria-hidden="true">&larr;</span>
    <span class="story-cards__hint-hover">Scroll, or hover a card to bring it forward</span>
    <span class="story-cards__hint-touch">Scroll sideways, or tap a card to bring it forward</span>
    <span aria-hidden="true">&rarr;</span>
  </p>
  <div class="story-row no-scrollbar" role="list">
    {
      articles.map((article, i) => {
        const primaryCategory = article.data.categories[0];
        const categoryLabel = CATEGORY_META[primaryCategory]?.label ?? primaryCategory;
        return (
          <a
            href={`/articles/${article.id}`}
            class="story-card"
            data-index={i}
            role="listitem"
            aria-label={`${article.data.title} — open article`}
          >
            <div class="story-card__media">
              {article.data.heroImage ? (
                <img
                  src={article.data.heroImage}
                  alt={article.data.heroImageAlt ?? ''}
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              ) : (
                <div class="story-card__placeholder" aria-hidden="true" />
              )}
            </div>
            <div class="story-card__scrim" aria-hidden="true" />
            <div class="story-card__spine" aria-hidden="true">
              <span class="story-card__spine-text">{article.data.title}</span>
            </div>
            <div class="story-card__content">
              {article.data.sample && <span class="story-card__sample">Sample content</span>}
              <span class="story-card__eyebrow">{categoryLabel}</span>
              <h3 class="story-card__title font-display">{article.data.title}</h3>
              <p class="story-card__summary">{article.data.summary}</p>
              <span class="story-card__cta">Dive in</span>
            </div>
          </a>
        );
      })
    }
  </div>
</div>

<style>
  .story-cards {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .story-cards__hint {
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink-500);
    margin: 0;
  }
  .story-cards__hint-touch {
    display: none;
  }
  @media (hover: none) {
    .story-cards__hint-hover {
      display: none;
    }
    .story-cards__hint-touch {
      display: inline;
    }
  }

  .story-row {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    padding: 0.5rem 0.25rem 1.5rem;
    height: 22rem;
  }

  @media (min-width: 768px) {
    .story-row {
      height: 30rem;
      gap: 0.75rem;
    }
  }

  .story-card {
    position: relative;
    flex: 0 0 4.5rem;
    border-radius: 2.25rem;
    overflow: hidden;
    scroll-snap-align: start;
    background: var(--color-ink-800);
    isolation: isolate;
    transition: flex-basis 550ms cubic-bezier(0.22, 1, 0.36, 1);
    text-decoration: none;
    outline-offset: 3px;
  }

  @media (min-width: 768px) {
    .story-card {
      flex-basis: 5.5rem;
      border-radius: 3rem;
    }
  }

  .story-card[data-expanded='true'] {
    flex-basis: min(26rem, 78vw);
  }

  @media (min-width: 768px) {
    .story-card[data-expanded='true'] {
      flex-basis: min(30rem, 60vw);
    }
  }

  .story-card__media,
  .story-card__placeholder {
    position: absolute;
    inset: 0;
  }
  .story-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85) brightness(0.75);
    transition: filter 550ms ease, transform 800ms cubic-bezier(0.22, 1, 0.36, 1);
    transform: scale(1.04);
  }
  .story-card__placeholder {
    background: linear-gradient(155deg, var(--color-ink-700), var(--color-ink-900));
  }

  .story-card[data-expanded='true'] .story-card__media img {
    filter: saturate(1) brightness(0.92);
    transform: scale(1);
  }

  .story-card__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(22, 19, 15, 0.95) 0%,
      rgba(22, 19, 15, 0.55) 45%,
      rgba(22, 19, 15, 0.25) 100%
    );
    opacity: 0.55;
    transition: opacity 400ms ease;
  }
  .story-card[data-expanded='true'] .story-card__scrim {
    opacity: 1;
  }

  /* Collapsed state: a vertical "spine" label, like a book on a shelf. */
  .story-card__spine {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-block-end: 1.25rem;
    opacity: 1;
    transition: opacity 250ms ease;
  }
  .story-card__spine-text {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    color: var(--color-paper-100);
    white-space: nowrap;
    max-height: 85%;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .story-card[data-expanded='true'] .story-card__spine {
    opacity: 0;
    pointer-events: none;
  }

  .story-card__content {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    opacity: 0;
    transform: translateY(0.5rem);
    transition: opacity 350ms ease 100ms, transform 350ms ease 100ms;
    pointer-events: none;
  }
  .story-card[data-expanded='true'] .story-card__content {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .story-card__sample {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-950);
    background: var(--color-brass-400);
    border-radius: 999px;
    padding: 0.2em 0.7em;
  }

  .story-card__eyebrow {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-brass-400);
  }

  .story-card__title {
    color: var(--color-paper-50);
    font-size: 1.35rem;
    line-height: 1.15;
    margin: 0;
  }
  @media (min-width: 768px) {
    .story-card__title {
      font-size: 1.75rem;
    }
  }

  .story-card__summary {
    color: var(--color-paper-200);
    font-size: 0.875rem;
    line-height: 1.4;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .story-card__cta {
    margin-top: 0.5rem;
    display: inline-flex;
    align-items: center;
    background: var(--color-paper-50);
    color: var(--color-ink-950);
    font-weight: 600;
    font-size: 0.85rem;
    padding: 0.55em 1.3em;
    border-radius: 999px;
    transition: background 200ms ease, transform 200ms ease;
  }
  .story-card:hover .story-card__cta,
  .story-card:focus-visible .story-card__cta {
    background: var(--color-brass-400);
  }
</style>

<script>
  function initStoryCards(root: HTMLElement) {
    const row = root.querySelector<HTMLElement>('.story-row');
    if (!row) return;
    const cards = Array.from(row.querySelectorAll<HTMLElement>('.story-card'));
    if (cards.length === 0) return;

    let revertTimer: ReturnType<typeof setTimeout> | null = null;

    function setActive(index: number) {
      cards.forEach((card, i) => {
        card.dataset.expanded = String(i === index);
      });
    }

    function scheduleRevert() {
      if (revertTimer) clearTimeout(revertTimer);
      revertTimer = setTimeout(() => setActive(0), 350);
    }

    const supportsHover = window.matchMedia('(hover: hover)').matches;

    cards.forEach((card, i) => {
      if (supportsHover) {
        card.addEventListener('pointerenter', () => {
          if (revertTimer) clearTimeout(revertTimer);
          setActive(i);
        });
      } else {
        // Touch devices: first tap on a collapsed card expands it instead of
        // navigating away, so the interaction is discoverable before committing.
        card.addEventListener('click', (event) => {
          if (card.dataset.expanded !== 'true') {
            event.preventDefault();
            setActive(i);
          }
        });
      }
      // Keyboard focus (e.g. Tab) expands a card — only wired for hover-capable
      // devices, since a touch tap also fires focus before its own click handler runs.
      if (supportsHover) {
        card.addEventListener('focus', () => setActive(i));
      }
    });

    if (supportsHover) {
      row.addEventListener('pointerleave', scheduleRevert);
    }

    setActive(0);
  }

  document.querySelectorAll<HTMLElement>('.story-cards').forEach(initStoryCards);
</script>
