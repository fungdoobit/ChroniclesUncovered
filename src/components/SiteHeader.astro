---
import { CATEGORY_META } from '@/lib/categories';
const categories = Object.entries(CATEGORY_META);
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-header__brand font-display">Chronicles Uncovered</a>
    <nav class="site-header__nav no-scrollbar" aria-label="Main">
      {
        categories.map(([slug, meta]) => (
          <a
            href={`/${slug}`}
            class="site-header__link"
            aria-current={currentPath.startsWith(`/${slug}`) ? 'page' : undefined}
          >
            {meta.label}
          </a>
        ))
      }
      <a href="/timelines" class="site-header__link">Timelines</a>
      <a href="/maps" class="site-header__link">Maps</a>
      <a href="/about" class="site-header__link">About</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--color-ink-950) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-ink-700);
  }
  .site-header__inner {
    max-width: 72rem;
    margin-inline: auto;
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .site-header__brand {
    color: var(--color-paper-50);
    font-size: 1.1rem;
    text-decoration: none;
    flex-shrink: 0;
  }
  .site-header__nav {
    display: flex;
    gap: 1.25rem;
    overflow-x: auto;
  }
  .site-header__link {
    font-size: 0.85rem;
    font-weight: 500;
    white-space: nowrap;
    color: var(--color-paper-200);
    text-decoration: none;
    padding-block: 0.25rem;
    border-bottom: 2px solid transparent;
  }
  .site-header__link:hover {
    color: var(--color-paper-50);
  }
  .site-header__link[aria-current='page'] {
    color: var(--color-brass-400);
    border-color: var(--color-brass-400);
  }
</style>
